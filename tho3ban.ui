     <property name="styleSheet">
      <string notr="true">QPushButton {
    background-color: #2ECC71; /* A nice bright green */
    color: white;
    border: 2px solid #27AE60; /* Darker green border */
    border-radius: 15px;       /* Rounded corners */
    font-size: 20px;
    font-weight: bold;
    padding: 10px;             /* Space inside the button */
}

/* 2. When the mouse hovers over the button */
QPushButton:hover {
    background-color: #27AE60; /* Slightly darker green */
    border: 2px solid #2ECC71; /* Swap the border color */
}

/* 3. When the button is actively being clicked */
QPushButton:pressed {
    background-color: #1E8449; /* Even darker green */
    padding-top: 12px;         /* Creates a &quot;push down&quot; effect */
    padding-bottom: 8px;
}</string>
