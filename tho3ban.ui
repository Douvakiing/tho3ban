     <property name="styleSheet">
      <string notr="true">/* 1. The normal button state (Red) */
QPushButton {
    background-color: #E74C3C; /* Bright red */
    color: white;
    border: 2px solid #C0392B; /* Darker red border */
    border-radius: 15px;       /* Rounded corners */
    font-size: 20px;
    font-weight: bold;
    padding: 10px;             /* Space inside the button */
}

/* 2. When the mouse hovers over the button */
QPushButton:hover {
    background-color: #C0392B; /* Slightly darker red */
    border: 2px solid #E74C3C; /* Swap the border color */
}

/* 3. When the button is actively being clicked */
QPushButton:pressed {
    background-color: #922B21; /* Even darker red */
    padding-top: 12px;         /* Creates a &quot;push down&quot; effect */
    padding-bottom: 8px;
}</string>
