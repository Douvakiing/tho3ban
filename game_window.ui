    <widget class="QPushButton" name="resetBtn">
     <property name="styleSheet">
      <string notr="true">/* Normal State */
QPushButton {
    background-color: transparent; 
    color: #00FFFF; /* Neon Cyan */
    border: 2px solid #00FFFF; 
    border-radius: 8px;
    font-size: 18px;
    font-weight: bold;
    font-family: &quot;Courier New&quot;, Courier, monospace;
    padding: 8px 15px;
}

/* Hover State (Lights up!) */
QPushButton:hover {
    background-color: rgba(0, 255, 255, 40); /* Adds a faint cyan glow behind the text */
    border: 2px solid #FFFFFF; /* Border turns white to simulate glowing brighter */
    color: #FFFFFF;
}

/* Pressed State (Flashes Pink) */
QPushButton:pressed {
    background-color: #FF00FF; /* Solid Neon Magenta */
    color: #000000;            /* Dark text so it's readable against the pink */
    border: 2px solid #FF00FF;
    padding-top: 10px;         /* Creates a push-down effect */
    padding-bottom: 6px;
}</string>
     </property>
     <property name="text">
      <string>Restart</string>
     </property>
    </widget>
